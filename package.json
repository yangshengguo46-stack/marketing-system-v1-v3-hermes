{
  "name": "marketing-os-desktop",
  "version": "0.1.0",
  "description": "智能营销系统 — AI驱动的短视频营销桌面应用",
  "author": "yucheng",
  "license": "MIT",
  "scripts": {
    "dev": "npm --prefix runtime/hermes-agent/apps/desktop run dev",
    "dev:web": "npm --prefix runtime/hermes-agent/apps/desktop run dev:renderer",
    "dev:electron": "npm --prefix runtime/hermes-agent/apps/desktop run dev:electron",
    "build": "npm --prefix runtime/hermes-agent/apps/desktop run build",
    "build:mac": "npm --prefix runtime/hermes-agent/apps/desktop run dist:mac",
    "build:win": "npm --prefix runtime/hermes-agent/apps/desktop run dist:win",
    "preview": "npm --prefix runtime/hermes-agent/apps/desktop run preview",
    "runtime:bootstrap": "./scripts/bootstrap-hermes-runtime.sh",
    "runtime:verify": ".venv/bin/python scripts/verify-hermes-runtime.py",
    "runtime:status": "./scripts/run-hermes-source.sh status",
    "clean:local": "bash scripts/clean-local-artifacts.sh",
    "test:core": ".venv/bin/python -m pytest -q tests/test_agent_core.py",
    "verify:packaged-agent": "python3 scripts/smoke-packaged-agent.py",
    "test": ".venv/bin/python -m pytest -q && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@playwright/mcp": "0.0.77",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  }
}
