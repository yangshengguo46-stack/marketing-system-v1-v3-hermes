{
  "name": "marketing-os-desktop",
  "version": "0.1.0",
  "description": "智能营销系统 — AI驱动的短视频营销桌面应用",
  "author": "yucheng",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:web": "vite",
    "dev:electron": "electron .",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "npm run build:backend && vite build && node scripts/build-electron.mjs",
    "build:mac": "npm run build:backend && vite build && node scripts/build-electron.mjs --mac",
    "build:win": "npm run build:backend && vite build && node scripts/build-electron.mjs --win",
    "preview": "vite preview",
    "runtime:bootstrap": "./scripts/bootstrap-hermes-runtime.sh",
    "runtime:status": "./scripts/run-hermes-source.sh status",
    "test:core": ".venv/bin/python -m pytest -q tests/test_agent_core.py",
    "test": ".venv/bin/python -m pytest -q && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "recharts": "^2.15.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.0",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.marketing-os.desktop",
    "productName": "智能营销",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/assets/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "electron/channel_bridge.py"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/assets/icon.png",
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "src/assets/icon.png"
    },
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend"
      },
      {
        "from": "engine/marketing-os",
        "to": "hermes-plugins/marketing-os"
      }
    ]
  }
}
